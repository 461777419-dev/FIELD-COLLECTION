{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "图集",
  "mainBinaryName": "图集",
  "version": "1.0.3",
  "identifier": "local.fieldjournal.referenceboard",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/runtime": "runtime"
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "compression": "lzma",
        "installerHooks": "installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
